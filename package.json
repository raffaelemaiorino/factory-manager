{
  "name": "factory-manager",
  "version": "2.5.4",
  "description": "Unofficial local production planner for Satisfactory — chains, machines, rates, and power on your PC.",
  "productName": "Factory Manager",
  "desktopName": "factory-manager.desktop",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "import:items": "node scripts/import-items.js",
    "import:buildings": "node scripts/import-buildings.js",
    "import:building-power": "node scripts/import-building-power.js",
    "import:details": "node scripts/import-item-details.js",
    "import:stack-sizes": "node scripts/import-stack-sizes.js",
    "import:vehicles": "node scripts/import-vehicles.js",
    "import:locale": "node scripts/import-locale.js",
    "import:locale:en": "node scripts/import-locale.js --locale en",
    "import:locale:all": "node scripts/import-locale-all.js",
    "import:locale:all:names": "node scripts/import-locale-all.js --skip-details",
    "test": "node --test test/**/*.test.js",
    "build": "electron-builder --win",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.factorymanager.app",
    "productName": "Factory Manager",
    "copyright": "Copyright © Raffaele Maiorino",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/sql.js/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/renderer/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Factory Manager"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "src/renderer/assets/app-icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "src/renderer/assets/app-icon.png",
      "category": "Utility",
      "synopsis": "Unofficial fan-made production planner for Satisfactory",
      "syncDesktopName": true,
      "maintainer": "Raffaele Maiorino <raffaelemaiorino@gmail.com>"
    }
  },
  "keywords": [
    "satisfactory",
    "electron",
    "production-manager",
    "factory",
    "fan-made",
    "desktop",
    "sqlite",
    "javascript"
  ],
  "author": "Raffaele Maiorino",
  "license": "MIT",
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "html-to-image": "^1.11.13",
    "sql.js": "^1.12.0"
  },
  "social": {
    "facebook": "https://www.facebook.com/groups/factorymanager"
  }
}
